# Resend API Configuration (for OTP emails)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=no-reply@right.app

# JWT Configuration
JWT_SECRET_KEY=change_me_to_a_strong_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# For local development (SQLite):
DATABASE_URL=sqlite:///./right.db

# For production (Supabase/PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:port/database
# Example Supabase format:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Admin Configuration
ADMIN_EMAIL=your-email@example.com

# IoT Webhook Security (optional)
IOT_WEBHOOK_SECRET=optional_shared_secret_for_iot_webhook

# Development Settings
DEV_ENABLE_TEST_LOGIN=1
DEV_TEST_USER_EMAIL=test@example.com
