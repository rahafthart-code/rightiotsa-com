# Production Environment Variables for rightiotsa.com Backend

# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT Secret (Generate a secure random key)
JWT_SECRET_KEY=your_secure_jwt_secret_key_here_change_in_production

# Frontend URLs
FRONTEND_URL=https://rightiotsa.com
DASHBOARD_URL=https://rightiotsa.com/dashboard

# Webhook Base URL (your deployed backend URL)
WEBHOOK_BASE_URL=https://rightiotsa.com/api
# Alternative if backend is on Railway:
# WEBHOOK_BASE_URL=https://rightiotsa-backend-production.up.railway.app

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
ADMIN_EMAIL=info@rightiotsa.com

# Payment Gateway (Payflowly)
PAYFLOWLY_API_KEY=your_payflowly_api_key
PAYFLOWLY_SECRET_KEY=your_payflowly_secret_key

# Development/Testing (DISABLE IN PRODUCTION)
DEV_TESTING_OTP=1234
DEV_ENABLE_TEST_LOGIN=0
DEV_TEST_USER_EMAIL=test@example.com

# CORS Origins (already configured in main.py)
# Supports: rightiotsa.com, www.rightiotsa.com, api.rightiotsa.com
